<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Page 2: timers, speed dial (number looked up at tap time, never stored). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Page 2's "today" line: unlock count and screen time. Granted under Settings > Usage access. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!-- Speed dial calls; the phone hardware isn't required to install. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Lets the launcher see every app that has a home-screen icon. -->
    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.walletnfcrel" />
        <!-- Page 5: fuel and drive taps start navigation in Google Maps. -->
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="cover"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cover">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Page 5: where Spotify sends you back after approving cover. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="coverlauncher" android:host="spotify" android:path="/callback" />
            </intent-filter>
        </activity>

        <!-- Needed to read and control what's playing (Spotify etc.). Holds no notification content. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="cover media controls"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Takeover: brings cover back in front when Samsung's cover home appears. Reads app names only. -->
        <service
            android:name=".CoverWatch"
            android:exported="true"
            android:label="cover takeover"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/cover_watch" />
        </service>
    </application>
</manifest>
